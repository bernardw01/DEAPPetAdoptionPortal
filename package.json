{
  "name": "pet-rescue-by-judy",
  "private": true,
  "version": "0.6.1",
  "type": "module",
  "workspaces": [
    ".wasp/out/*",
    ".wasp/out/sdk/wasp"
  ],
  "scripts": {
    "start": "wasp start",
    "compile": "wasp compile",
    "test": "wasp test client run",
    "test:bootstrap": "node scripts/bootstrap-smoke.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "capability:add": "node scripts/apply-capability-pack.mjs",
    "database:check": "node scripts/database-check.mjs",
    "database:init": "npm run database:check && wasp db migrate-dev",
    "version:check": "node scripts/version-check.mjs",
    "version:bump": "node scripts/version.mjs",
    "sdlc:check": "node scripts/sdlc-check.mjs",
    "template:check": "node scripts/template-check.mjs && npm run version:check",
    "test:prerender": "node scripts/prerender-check.mjs",
    "test:e2e": "playwright test",
    "test:lighthouse": "node scripts/lighthouse-home.mjs",
    "sdlc:validate": "npm run sdlc:check && npm run template:check && npm run test:bootstrap && npm test && npm run compile && npm run test:prerender && npm run test:e2e && npm run test:lighthouse",
    "sdlc:ship": "npm run sdlc:validate"
  },
  "dependencies": {
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router": "^8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@wasp.sh/spec": "file:.wasp/spec/",
    "jsdom": "^30.1.3",
    "lighthouse": "^13.5.0",
    "prisma": "5.19.1",
    "serve": "^14.2.6",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
